<?xml version="1.0" encoding="utf-8"?>
<!--
  NetLabCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build netlabcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc netlabcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -d HasCli=1 -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder
  (Program Files\NetLabCraft by default, remembered for upgrades), Ready, a progress page, and a
  Finish page with a ticked "Launch NetLabCraft" box. Installs a Start Menu shortcut and an
  App Paths entry (Win+R "netlabcraft"), plus netlabcraft-cli when HasCli=1. No file types are
  claimed yet: A later release can register the .nlcraft file type.
  `msiexec /qn` still installs silently.

  UpgradeCode is fixed for NetLabCraft forever (generated once; never reuse another app's).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="NetLabCraft"
      Manufacturer="NetLabCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="901628DA-E212-4FAE-A025-505251BFCFA7"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NetLabCraft: network labs for learning and teaching" Manufacturer="NetLabCraft contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NetLabCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="NetLabCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NetLabCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ayozetr/netlabcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/ayozetr/netlabcraft" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ayozetr/netlabcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NetLabCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by NetLabCraftApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\NetLabCraft" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="NetLabCraft" Level="1">
      <ComponentGroupRef Id="NetLabCraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNetLabCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through netlabcraft.en-us.wxl. -->
    <Property Id="NetLabCraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="NetLabCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NetLabCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NetLabCraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchNetLabCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="NetLabCraftFiles" Directory="INSTALLFOLDER">
      <Component Id="NetLabCraftApp" Guid="2169FE50-8103-477E-A130-704ADE295DD5">
        <File Id="NetLabCraftExe" Source="$(var.BinDir)\netlabcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NetLabCraft"
              Description="Network labs for learning and teaching" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NetLabCraftIcon.exe" IconIndex="0" />
        </File>

        <!-- The "Open with" app list and the Run dialog (Win+R "netlabcraft"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\netlabcraft.exe" Name="FriendlyAppName" Value="NetLabCraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\netlabcraft.exe\shell\open\command" Value="&quot;[#NetLabCraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\netlabcraft.exe" Value="[#NetLabCraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\NetLabCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="NetLabCraftCli">
        <File Id="NetLabCraftCliExe" Source="$(var.BinDir)\netlabcraft-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
